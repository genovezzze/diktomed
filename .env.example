# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=change-me-long-random
# openssl rand -base64 48
SESSION_SECRET=change-me-at-least-32-characters-long-random-string

# First administrator, created on the first start.
SEED_ADMIN_EMAIL=admin@slimnica.lv
SEED_ADMIN_PASSWORD=change-me-12-chars-min
SEED_ADMIN_NAME=Administrators

ORG_NAME=Slimnīca

# Where the web app listens. 127.0.0.1 = this machine only; put a TLS reverse
# proxy in front for the hospital network, then set COOKIE_SECURE=true.
WEB_BIND=127.0.0.1
WEB_PORT=3000
COOKIE_SECURE=false

# Only for demos: lets fictional "fake" transcripts be approved. Never in a hospital.
DEMO_MODE=false

# true only behind a reverse proxy that sets X-Forwarded-For (then the client IP
# is logged and rate-limited). Otherwise anyone could fake it.
TRUST_PROXY=false

# Recogniser. "fake" shows a fictional demo dictation without a model or GPU.
ASR_BACKEND=faster-whisper
ASR_MODEL=/models/whisper-lv-ct2
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
ASR_LANGUAGE=lv
AUDIO_DENOISE=false

# A correction repeated this many times becomes a suggestion.
CORRECTION_MIN_COUNT=2

# Delete audio this many days after approval (0 = keep). Agree with the DPO.
RETENTION_DAYS=0

# Optional local LLM (Ollama/vLLM on the hospital network), e.g.
# LLM_BASE_URL=http://10.0.0.5:11434/v1  LLM_MODEL=gemma3:12b
LLM_BASE_URL=
LLM_MODEL=
# Protocol drafting: "llm" (needs the two lines above) or "rules" (no model).
# Empty = llm when an LLM is configured, rules otherwise.
PROTOCOL_BACKEND=
