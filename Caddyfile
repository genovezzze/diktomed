# Reverse proxy in front of DiktoMed (docker-compose.tls.yml).
# The certificate comes from the hospital; Caddy never contacts the internet.
{
	admin off
	auto_https off
	ocsp_stapling off
}

https://{$DIKTOMED_HOST} {
	tls /certs/cert.pem /certs/key.pem
	request_body {
		max_size 350MB
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy web:3000
}

http://{$DIKTOMED_HOST} {
	redir https://{host}{uri} permanent
}
