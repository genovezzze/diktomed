// DiktoMed data model.
//
// Tables and columns are snake_case (@@map / @map) because the Python worker
// reads and writes the same tables with plain SQL. Ids are generated by
// Postgres (gen_random_uuid) so both sides can insert rows.
//
// Patient data lives in recordings (audio on disk), segments and documents.
// Everything runs inside the hospital network; nothing here talks to the
// internet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TRANSCRIBER
  DOCTOR

  @@map("user_role")
}

enum RecordingStatus {
  QUEUED
  PROCESSING
  READY
  APPROVED
  FAILED

  @@map("recording_status")
}

/// Side of the operation as planned, entered on upload (later: from the HIS).
enum Side {
  LEFT
  RIGHT
  BOTH

  @@map("side")
}

enum FlagKind {
  SIDE_MISMATCH
  POSSIBLE_HALLUCINATION
  LOW_CONFIDENCE_LINE
  LOW_CONFIDENCE_WORD
  NUMBER
  TERM
  AI_SUGGESTION

  @@map("flag_kind")
}

enum FlagSeverity {
  HIGH
  MEDIUM
  INFO

  @@map("flag_severity")
}

enum FlagStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@map("flag_status")
}

enum EditSource {
  HUMAN
  SUGGESTION_ACCEPTED

  @@map("edit_source")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED

  @@map("job_status")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(TRANSCRIBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  uploads   Recording[] @relation("uploadedBy")
  approvals Recording[] @relation("approvedBy")
  edits     Edit[]
  documents Document[]
  auditLogs AuditLog[]

  @@map("users")
}

model Recording {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  originalName    String          @map("original_name")
  /// Directory under STORAGE_DIR that holds original.* and normalized.wav.
  storageKey      String          @map("storage_key")
  mimeType        String?         @map("mime_type")
  sizeBytes       Int             @map("size_bytes")
  durationSec     Float?          @map("duration_sec")
  language        String?
  languageProb    Float?          @map("language_prob")
  plannedSide     Side?           @map("planned_side")
  modelName       String?         @map("model_name")
  status          RecordingStatus @default(QUEUED)
  errorMessage    String?         @map("error_message")
  /// 0..1 while the worker recognises speech; shown with a time estimate.
  progress        Float?
  uploadedById    String          @map("uploaded_by_id") @db.Uuid
  approvedById    String?         @map("approved_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  processingStart DateTime?       @map("processing_started_at") @db.Timestamptz(3)
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(3)
  approvedAt      DateTime?       @map("approved_at") @db.Timestamptz(3)
  /// Set by the retention job once the audio files are removed from disk.
  audioDeletedAt  DateTime?       @map("audio_deleted_at") @db.Timestamptz(3)

  uploadedBy User       @relation("uploadedBy", fields: [uploadedById], references: [id])
  approvedBy User?      @relation("approvedBy", fields: [approvedById], references: [id])
  segments   Segment[]
  flags      Flag[]
  edits      Edit[]
  document   Document?
  jobs       Job[]
  auditLogs  AuditLog[]

  @@index([status, createdAt])
  @@map("recordings")
}

model Segment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId      String    @map("recording_id") @db.Uuid
  idx              Int
  start            Float
  end              Float
  /// Current text: the model's output, then whatever the reviewer saved.
  text             String
  /// The model's text, never changed. Used for quality metrics and training.
  originalText     String    @map("original_text")
  /// Mean word probability, 0..1.
  confidence       Float
  avgLogprob       Float?    @map("avg_logprob")
  noSpeechProb     Float?    @map("no_speech_prob")
  compressionRatio Float?    @map("compression_ratio")
  /// [{ "w": "hemostāze", "s": 12.1, "e": 12.6, "p": 0.93 }, ...]
  words            Json      @default("[]")
  editedAt         DateTime? @map("edited_at") @db.Timestamptz(3)

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  flags     Flag[]
  edits     Edit[]

  @@unique([recordingId, idx])
  @@map("segments")
}

model Flag {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId  String       @map("recording_id") @db.Uuid
  segmentId    String?      @map("segment_id") @db.Uuid
  kind         FlagKind
  severity     FlagSeverity
  start        Float
  end          Float
  message      String
  /// The text the flag is about, exactly as it appears in the segment.
  excerpt      String?
  /// Proposed replacement for the excerpt. Never applied without a person.
  suggestion   String?
  status       FlagStatus   @default(OPEN)
  resolvedById String?      @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  segment   Segment?  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([recordingId, status])
  @@map("flags")
}

model Edit {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId String     @map("recording_id") @db.Uuid
  segmentId   String     @map("segment_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  source      EditSource @default(HUMAN)
  before      String
  after       String
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  segment   Segment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([recordingId])
  @@map("edits")
}

model Document {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId  String   @unique @map("recording_id") @db.Uuid
  text         String
  approvedById String   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime @default(now()) @map("approved_at") @db.Timestamptz(3)

  recording  Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  approvedBy User      @relation(fields: [approvedById], references: [id])

  @@map("documents")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  recordingId String?  @map("recording_id") @db.Uuid
  action      String
  details     Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User?      @relation(fields: [userId], references: [id])
  recording Recording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([recordingId])
  @@map("audit_logs")
}

model Job {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId String    @map("recording_id") @db.Uuid
  kind        String    @default("TRANSCRIBE")
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("jobs")
}

/// Vocabulary passed to the recogniser as a hint (Whisper initial prompt).
model Term {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("terms")
}

/// Learned from reviewers' edits: what the model heard and what the person
/// wrote instead. Repeated pairs become suggestions on new dictations.
model TermCorrection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wrong     String
  right     String
  count     Int      @default(1)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([wrong, right])
  @@map("term_corrections")
}
